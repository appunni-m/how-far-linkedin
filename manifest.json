{
  "manifest_version": 3,
  "name": "How Far? for LinkedIn",
  "version": "0.2.3",
  "description": "Show local company office addresses and home-to-office distances on LinkedIn job search pages.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://places.googleapis.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Set up How Far?",
    "default_popup": "popup.html"
  }
}
